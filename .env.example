DB_NAME=orion
DB_USER=orion
DB_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password

REDIS_PASSWORD=replace-with-a-local-password

RABBITMQ_USER=orion
RABBITMQ_PASSWORD=replace-with-a-local-password
RABBITMQ_REALTIME_PREFETCH=64

# Generate a random value with at least 32 characters. Do not reuse this example.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars

# Optional runtime tuning. These values match the Docker Compose defaults.
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576

WEBSOCKET_HANDSHAKE_TIMEOUT=5s
WEBSOCKET_WRITE_TIMEOUT=10s
WEBSOCKET_PONG_TIMEOUT=60s
WEBSOCKET_PING_INTERVAL=45s
WEBSOCKET_READ_LIMIT_BYTES=4096
WEBSOCKET_CLIENT_SEND_QUEUE_CAPACITY=64
WEBSOCKET_ROOM_BROADCAST_QUEUE_CAPACITY=256
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_USER=3

DEPENDENCY_INIT_TIMEOUT=15s
PROCESS_SHUTDOWN_TIMEOUT=10s
ACCESS_TOKEN_TTL=15m

DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
